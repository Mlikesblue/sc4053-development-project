# Testnet deployment configuration. Copy this file to `.env` and fill in both
# variables before running reproduce/sepolia-deploy.sh. `.env` is gitignored
# and must stay out of version control.

# JSON-RPC endpoint for Sepolia. Any HTTPS Sepolia RPC works; the course
# materials recommend Alchemy (https://dashboard.alchemy.com — create a free
# app for the Ethereum Sepolia network and copy its HTTPS URL).
SEPOLIA_RPC_URL=

# Hex-prefixed (0x…) private key of the wallet you deploy from. Export it from
# MetaMask (Account details → Show private key) or generate a throwaway with
# `cast wallet new`. The wallet must hold at least ~0.05 Sepolia ETH; fund it
# at https://cloud.google.com/application/web3/faucet/ethereum/sepolia,
# https://sepolia-faucet.pk910.de, or the Alchemy Sepolia faucet.
PRIVATE_KEY=
